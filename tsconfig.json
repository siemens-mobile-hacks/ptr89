{
	"compilerOptions": {
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "DOM"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "build-wasm"]
}
